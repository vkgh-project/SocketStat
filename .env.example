# Copy to .env. Do not commit real credentials.
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
SOCKET_1_ID=
SOCKET_1_NAME=Розетка 1
SOCKET_2_ID=
SOCKET_2_NAME=Розетка 2
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DB_PATH=./data/socketstat.db
# Optional: synthetic data, no Tuya calls. Never represents a real measurement.
DEMO_MODE=false
# PythonAnywhere restricted accounts: Tuya must also be on the host allowlist.
# A proxy does not bypass that restriction. Paid accounts normally need no override.
# HTTPS_PROXY=http://proxy.server:3128

# Optional fallback; normally PythonAnywhere supplies API_TOKEN automatically.
# PYTHONANYWHERE_API_TOKEN=
